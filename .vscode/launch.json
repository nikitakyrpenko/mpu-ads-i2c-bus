{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug i2c_bus (simulator)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/i2c_bus",
      "args": ["/dev/i2c-1", "0x48", "0x68"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "LD_PRELOAD", "value": "${workspaceFolder}/scripts/libi2csim.so" }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CMake: configure and build",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
